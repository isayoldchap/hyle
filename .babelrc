{
    "presets": [ 
        [
            "@babel/preset-env",
            {
                "exclude" : ["@babel/plugin-transform-regenerator", "transform-explicit-resource-management"]
            }
        ],
        "@babel/preset-react"
     ],
     "plugins": [
        "@babel/plugin-transform-modules-commonjs",
        "@babel/plugin-proposal-class-properties"
    ]
}